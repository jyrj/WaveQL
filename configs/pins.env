# WaveQL / BuggyBOOM third-party pins.
# Every SHA resolved from the real remote on 2026-09-04 by
# scripts/setup/resolve_pins.sh. Never hand-edit.

# --- CHIA framework ----------------------------------------------------------
CHIA_URL=https://github.com/ucb-bar/chia
CHIA_REF=a2c4dae46528055efa59444d54832336851f633f      # v1.0.1 release merge
CHIA_PYPI=chialoops==1.0.1

# --- Chipyard ----------------------------------------------------------------
# The `chia_artifact` branch is what CHIA's own ChipyardDockerfile clones. It is
# NOT upstream main: it carries the harness support this project depends on --
# `WithSelectiveWaveform` (PC-triggered VCD windows, HarnessBinders.scala:323)
# and the WF_SCOPES compile-time scope filter (sims/verilator/Makefile:80).
CHIPYARD_URL=https://github.com/ucb-bar/chipyard
CHIPYARD_REF=4ab72313087580a44d647b52923389a06ec0712f
CHIPYARD_BRANCH=chia_artifact

# --- Conda (chipyard build-setup step 1) -------------------------------------
# Installed into tools/conda; no system packages, nothing written outside the repo.
MINIFORGE_VERSION=26.5.3-0
MINIFORGE_URL=https://github.com/conda-forge/miniforge/releases/download/26.5.3-0/Miniforge3-26.5.3-0-Linux-x86_64.sh

# --- Waveform ingest ---------------------------------------------------------
# pywellen: Rust `wellen` bindings; the streaming VCD/FST parser WaveQL ingests with.
PYWELLEN_PYPI=pywellen==0.25.6
WELLEN_URL=https://github.com/ekiwi/wellen
WELLEN_REF=34f40595c4330bcac364397679cdc3d5ae6b5c0c

# --- Baseline arm (arm 1): the incumbent open-source waveform tool bag --------
WAVE_MCP_PYPI=wave-mcp==0.2.1

# --- Store -------------------------------------------------------------------
DUCKDB_PYPI=duckdb==1.5.5
PYARROW_PYPI=pyarrow==25.0.1

# --- Designs under test (vendored inside chipyard as submodules; recorded for
#     provenance so the mutation targets are attributable to a commit) --------
BOOM_URL=https://github.com/riscv-boom/riscv-boom
ROCKETCHIP_URL=https://github.com/chipsalliance/rocket-chip
RISCV_TESTS_URL=https://github.com/riscv-software-src/riscv-tests

# --- Host tools recorded for provenance (not built) --------------------------
# verilator 5.046 2026-02-28 rev fedora-5.046   (chipyard's conda env ships its own)
# yosys 0.67+post (22c15a7ecd53437f18f67c72572bd693f78357ca)
# glibc 2.43 (Fedora 44)  <-- see patches/0001-chipyard-pin-conda-sysroot.patch
