# Copy to configs/gcp.env and fill in. Sourced (set -a) by the agent runners.
# Authentication is Application Default Credentials: `gcloud auth application-
# default login` on a workstation, the VM's service account on GCE.

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global          # Gemini 3.x is served from `global`
GOOGLE_GENAI_USE_VERTEXAI=true

# The seat used for every reported result.
WAVEQL_MODEL_PRIMARY=gemini-3.1-pro-preview

# Multi-host runs only (scripts/cloud): where hosts mirror run files and claim
# verification cells.
# WAVEQL_SYNC=gs://your-bucket/sync
# WAVEQL_CLAIMS=gs://your-bucket/claims
